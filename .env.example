# TiDB Cloud / MySQL. Leave empty to use the local SQLite database in /data.
DATABASE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production. Locally, a secret is generated in /data/auth-secret.
AUTH_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=info@ajclasses.com

# Optional. If omitted, the first visit to /setup creates the super admin.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

VIDEO_STORAGE_PATH=
VIDEO_MAX_UPLOAD_SIZE=5368709120
FFMPEG_PATH=
FFPROBE_PATH=
MAX_CONCURRENT_TRANSCODES=1

# true forces demo checkout. false disables it. Unset: on only when Razorpay is missing and NODE_ENV is not production.
ALLOW_DEMO_CHECKOUT=
